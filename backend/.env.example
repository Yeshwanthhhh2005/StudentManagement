# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# MongoDB (Atlas connection string or local)
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/wa_campaigns

# ─────────────────────────────────────────────────────────────
# Redis (Redis Cloud or local) - used by BullMQ
# ─────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Default admin created on first seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ─────────────────────────────────────────────────────────────
# WhatsApp provider selection: "meta" (default) or "mock"
# ─────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=meta

# Country code prepended to bare 10-digit numbers during import (India=91)
DEFAULT_COUNTRY_CODE=91

# ── Meta WhatsApp Cloud API ──────────────────────────────────
# From Meta App Dashboard > WhatsApp > API Setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WABA_ID=
META_API_VERSION=v21.0
# A token you invent; must match what you set in the Meta webhook config
META_WEBHOOK_VERIFY_TOKEN=my_verify_token
# Used to validate webhook signatures (Meta App Secret)
META_APP_SECRET=

# ─────────────────────────────────────────────────────────────
# Queue / throughput tuning
# ─────────────────────────────────────────────────────────────
# Messages per second the worker is allowed to dispatch (Meta default tier ~80/s)
SEND_RATE_PER_SECOND=50
# How many jobs a single worker processes concurrently
WORKER_CONCURRENCY=20
# Max retry attempts per message on transient failure
JOB_MAX_ATTEMPTS=3
